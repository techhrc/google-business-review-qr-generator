# Server-only. Never prefix with NEXT_PUBLIC_ — that would ship the key to browsers.
# Only needed to resolve Maps *share* links (maps.app.goo.gl etc.): the Places
# Text Search call uses an ID-only field mask, which is Google's free
# "Text Search Essentials (IDs Only)" tier (unlimited). Review links, place_id
# URLs, and raw Place IDs work without any key.
GOOGLE_PLACES_API_KEY=

# Public site URL used for canonical links, sitemap, and OG tags.
NEXT_PUBLIC_SITE_URL=https://googlereviewqr.vercel.app
